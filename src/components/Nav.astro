---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog/', label: 'Blog' },
];

const path = Astro.url.pathname;

function isActive(href: string) {
	if (href === '/') return path === '/';
	return path.startsWith(href);
}
---

<nav class="site-nav">
	<a class="brand" href="/">stenbom.me</a>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
