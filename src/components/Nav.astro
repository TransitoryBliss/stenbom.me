---
const links = [
	{ href: '/', label: 'Blog' },
	{ href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;

function isActive(href: string) {
	// The blog index lives at /, and posts live under /blog/, so both count as "Blog".
	if (href === '/') return path === '/' || path.startsWith('/blog/');
	return path.startsWith(href);
}
---

<nav class="site-nav">
	<a class="brand" href="/">stenbom.me</a>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
		<li>
			<button class="theme-toggle" type="button" aria-label="Switch to dark theme">Dark</button>
		</li>
	</ul>
</nav>

<script>
	const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const root = document.documentElement;

	function sync() {
		if (!btn) return;
		const dark = root.dataset.theme === 'dark';
		btn.textContent = dark ? 'Light' : 'Dark';
		btn.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
	}

	btn?.addEventListener('click', () => {
		root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
		localStorage.setItem('theme', root.dataset.theme);
		sync();
		// Anything else that renders in the current theme (e.g. the comments iframe) listens for this.
		window.dispatchEvent(new CustomEvent('themechange', { detail: root.dataset.theme }));
	});

	sync();
</script>
